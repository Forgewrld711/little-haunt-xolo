{
  "manifest_version": 3,
  "name": "Little Haunt: Xolo",
  "version": "0.1.0",
  "description": "Invite a tiny xolo to haunt the current browser tab.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Invite the xolo",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/xolo-v1.png"],
      "matches": ["<all_urls>"]
    }
  ]
}
